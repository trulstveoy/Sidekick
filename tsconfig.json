{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    "forge.env.d.ts",
    "forge.config.ts",
    "vite.*.config.ts",
    "src/**/*.d.ts",
    "src/**/*.ts"
  ]
}
