{
  "name": "sidekick",
  "productName": "Sidekick",
  "version": "0.1.2",
  "description": "Local project folder intelligence workspace built with Electron.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "dev:renderer": "vite --config vite.renderer.config.ts --host 127.0.0.1 --port 5173",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:watch": "vitest tests/unit tests/integration",
    "test:ui": "playwright test",
    "verify:packaged-context": "node scripts/ci/verify-packaged-context-package.mjs",
    "check": "npm run lint && npm run typecheck",
    "spike:repomix": "node scripts/spikes/repomix-spike.mjs"
  },
  "keywords": [
    "electron",
    "folders",
    "notes",
    "desktop"
  ],
  "author": "trutve",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.59.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "42.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@secretlint/core": "^11.7.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "electron-squirrel-startup": "^1.0.1",
    "repomix": "^1.14.0"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.2"
  }
}
